# Copy this file to .env (or app/.env) for local runs.
# When deploying to Cloud Run via ./deploy.sh, these are injected automatically.

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Vertex AI Gemini model (default: gemini-2.5-flash; override with e.g. gemini-3-flash-preview)
GEMINI_MODEL=gemini-2.5-flash

# Safety mode:
#   readonly  = inspect FinOps Hub / Monitoring / Logs + generate Terraform/YAML only (recommended for first trial)
#   readwrite = allows executing approved remediation actions & syncing FinOps Hub markClaimed/markSucceeded
AGENT_EXECUTION_MODE=readonly

# Optional: Set your Cloud Billing Account ID (e.g. 01ABCD-234567-89EFGH) to include CUD recommendations
BILLING_ACCOUNT_ID=

# Optional: Comma-separated MCP servers to skip if not used in your environment (e.g. gke,bigquery)
DISABLED_MCP_SERVERS=
